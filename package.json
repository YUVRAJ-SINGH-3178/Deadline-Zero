{
  "name": "deadline-zero",
  "version": "0.1.0",
  "private": true,
  "description": "Deadline Zero — an adaptive planning agent for Alexa+",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "npm run build:ui && tsc -p tsconfig.json",
    "build:ui": "tsx scripts/build-ui.ts",
    "assets": "tsx scripts/generate-store-assets.ts",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml,css,html}\"",
    "bench": "tsx scripts/benchmark.ts",
    "bench:mcp": "node dist/scripts/benchmark-mcp.js",
    "demo:seed": "node --env-file-if-exists=.env --import tsx scripts/seed-demo.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "security": "npm audit --omit=dev"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.2.1",
    "fastify": "^5.3.3",
    "jose": "^6.0.11",
    "pg": "^8.16.0",
    "zod": "^3.25.49"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/pg": "^8.15.4",
    "eslint": "^9.28.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^5.0.3",
    "esbuild": "^0.25.5",
    "typescript-eslint": "^8.34.1",
    "prettier": "^3.5.3"
  }
}
